{
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.112.4",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.123.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1"
  },
  "fmt": { "lineWidth": 100, "indentWidth": 2, "singleQuote": false },
  "lint": { "rules": { "tags": ["recommended"] } },
  "tasks": {
    "check": "deno check $(find . -name '*.ts')",
    "test": "deno test --allow-env --allow-net=127.0.0.1"
  }
}
